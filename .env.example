# Site
NEXT_PUBLIC_SITE_URL=https://authorscrew.com

# Resend (https://resend.com) - email delivery for all forms
RESEND_API_KEY=
FORM_TO_EMAIL=info@authorscrew.com
FORM_FROM_EMAIL="Authors Crew <forms@authorscrew.com>"

# Cloudflare Turnstile - spam protection (leave empty in local dev to skip)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
