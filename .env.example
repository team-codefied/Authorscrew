# Site
NEXT_PUBLIC_SITE_URL=https://authorscrew.com

# Email delivery for all forms: the Hostinger mailbox you already have (SMTP)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@authorscrew.com
SMTP_PASS=
# Who receives submissions (comma-separated). Defaults to SMTP_USER.
FORM_TO_EMAIL=info@authorscrew.com

# Optional: Cloudflare Turnstile. Leave both empty to skip it (honeypot + rate limit still apply)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
